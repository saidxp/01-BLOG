# Copy this file to .env and fill in real values. NEVER commit .env.
# The actual .env is git-ignored; this template documents the required keys.

# --- Security (REQUIRED, use strong unique values in production) ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=8000000

# --- Database ---
POSTGRES_DB=blogdb
POSTGRES_USER=bloguser
POSTGRES_PASSWORD=change-me

# --- App deployment settings ---
# Set to true when serving the app over HTTPS only
COOKIE_SECURE=false
# Comma-separated usernames promoted to ADMIN at backend startup
BOOTSTRAP_ADMIN_USERNAMES=
# Use "prod" for production deployments
SPRING_PROFILES_ACTIVE=
